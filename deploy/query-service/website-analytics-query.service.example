# PROPOSAL ONLY. Not installed, started or enabled.
# Requires approval for the new service identity, directories and service lifecycle.
[Unit]
Description=Read-only fixed evidence website analytics query
After=network.target
ConditionPathExists=/var/lib/website-analytics-query/cases.sqlite
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=analyticsquery
Group=analyticsquery
WorkingDirectory=/opt/website-analytics-query/current
Environment=PYTHONPATH=/opt/website-analytics-query/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/website-analytics-query/current/venv/bin/python -B -m website_analytics.analysis.service --cases /var/lib/website-analytics-query/cases.sqlite --port 8765
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
ReadOnlyPaths=/opt/website-analytics-query /var/lib/website-analytics-query
InaccessiblePaths=-/opt/website-analytics -/var/lib/website-analytics -/etc/ssh
MemoryMax=256M
TasksMax=32
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
