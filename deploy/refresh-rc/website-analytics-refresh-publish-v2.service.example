# PROPOSAL ONLY. Separate root publisher; no source env, network or SDK.
[Unit]
Description=Publish bounded repeatable website analytics handoffs

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/website-analytics-refresh/releases/@RELEASE_ID@
ExecStart=/opt/website-analytics-refresh/releases/@RELEASE_ID@/venv-query/bin/python -I -B /opt/website-analytics-refresh/releases/@RELEASE_ID@/deploy/refresh-rc/publish-repeatable.py
UMask=0077
Restart=no
TimeoutStartSec=90
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/website-analytics-query/live
InaccessiblePaths=/opt/website-analytics /var/lib/website-analytics /etc/ssh
MemoryMax=256M
TasksMax=16
StandardOutput=journal
StandardError=journal
