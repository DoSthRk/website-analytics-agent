[Unit]
Description=Website analytics aggregate sync (%i)
After=network-online.target cyber.service
Wants=network-online.target
Requires=cyber.service

[Service]
Type=oneshot
User=websiteanalytics
Group=websiteanalytics
WorkingDirectory=/opt/website-analytics/current
EnvironmentFile=/opt/website-analytics/shared/analytics.env
Environment=HOME=/var/lib/website-analytics
Environment=GOOGLE_APPLICATION_CREDENTIALS=/var/lib/website-analytics/.config/gcloud/application_default_credentials.json
Environment=LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1
Environment=LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1
Environment=LARK_CLI_HTTP_PROXY=http://127.0.0.1:8890
Environment=LARK_CLI_HTTPS_PROXY=http://127.0.0.1:8890
Environment=PATH=/opt/website-analytics/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=PYTHONPATH=/opt/website-analytics/current/src
ExecStartPre=-+/usr/sbin/ip rule del priority 8999 to 65.49.212.57/32 lookup main
ExecStartPre=+/usr/sbin/ip rule add priority 8999 to 65.49.212.57/32 lookup main
ExecStartPre=+/usr/sbin/ip route flush cache
ExecStartPre=/opt/website-analytics/venv/bin/python /opt/website-analytics/current/scripts/configure_cyber_proxy.py
ExecStart=/usr/bin/flock -n /opt/website-analytics/shared/sync.lock /opt/website-analytics/venv/bin/python /opt/website-analytics/current/scripts/run_analytics_sync.py --scope %i --profile /opt/website-analytics/current/config/sync_profiles/genemedi-net.json --site-config /opt/website-analytics/current/config/sites.yaml --mapping /opt/website-analytics/current/config/product_mappings/genemedi-net.yaml --information-mapping /opt/website-analytics/current/config/information_mappings/genemedi-net.yaml --cache-dir /opt/website-analytics/shared/cache --audit-dir /opt/website-analytics/shared/audits --output-dir /opt/website-analytics/shared/sync-runs --target /opt/website-analytics/current/config/feishu_dashboard/v2/sync_target.json --v3-contract /opt/website-analytics/current/config/feishu_dashboard/v3/data_contract.json --v3-target /opt/website-analytics/current/config/feishu_dashboard/v3/sync_target.json --apply
ExecStopPost=-+/usr/sbin/ip rule del priority 8999 to 65.49.212.57/32 lookup main
ExecStopPost=-+/usr/sbin/ip route flush cache
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/website-analytics/shared /var/lib/website-analytics

[Install]
WantedBy=multi-user.target
