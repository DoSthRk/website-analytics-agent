{
  "version": "1",
  "dashboards": [
    {
      "name": "产品诊断",
      "blocks": [
        {
          "name": "阅读说明",
          "type": "text",
          "data_config": {
            "text": "# 产品诊断 · 周/月对照历史\n**先在顶部“筛选”里选好两项**，产品漏斗周期数据、产品变化定位两张表要改成一样，否则数值会被重复相加：\n1. **范围名称**：全部产品、一级/二级分类或单个产品。\n2. **对照方式**：按周看选“前8周均值 / 前12周均值 / 去年同期”，按月看选“前3月均值 / 前6月均值 / 去年同月”。\n\n阅读顺序：① 哪里变了 → ② 哪一层开始变 → ③ 是不是季节性。口径见页面底部。"
          }
        },
        {
          "name": "异常项数（最近完整周）",
          "type": "statistics",
          "data_config": {
            "table_name": "产品变化定位",
            "count_all": true,
            "filter": {
              "conjunction": "and",
              "conditions": [
                {
                  "field_name": "是否异常",
                  "operator": "is",
                  "value": true
                }
              ]
            }
          }
        },
        {
          "name": "① 哪里变了",
          "type": "text",
          "data_config": {
            "text": "## ① 哪里变了 · 最近完整周 vs 基准\n从 1 往 9 找第一个明显偏离的项。按月看时变化定位为空。异常 = 偏离基准 30% 以上，且基准量达到最小量。"
          }
        },
        {
          "name": "变化定位（最近完整周）",
