{
  "version": "3",
  "status": "active",
  "write_enabled": true,
  "site": "genemedi-net",
  "model": "daily_time_x_product_with_information_dimensions",
  "date_filter": {
    "field": "数据日期",
    "mode": "custom_range",
    "inclusive": true,
    "default": "过去30天内",
    "maximum_history_days": 400,
    "rule": "只同步三类来源均达到最终状态的单日记录；看板按数据日期筛选后求和。"
  },
  "source_boundaries": {
    "ga4": "访问和关键事件；按 GA4 属性报表时区统计。",
    "gsc": "Google 自然搜索点击和曝光；按 Pacific Time 统计。",
    "inquiry": "官网数据库入库记录；按网站服务器日历统计。",
    "rule": "三个来源并列观察，不拼成严格转化漏斗。"
  },
  "non_additive_metrics": {
    "ga4_active_users": "跨日相加不能得到日期区间内的去重访客数，因此不进入自定义日期看板。",
    "gsc_ctr": "日期区间点击率必须用汇总点击除以汇总曝光，不能平均每日或分类行点击率。",
    "gsc_position": "日期区间平均排名需要按曝光加权，未验证飞书聚合公式前不进入默认看板。",
    "included_pages": "每日页面数跨日相加会重复，因此只保留在数据表中，不作为日期区间 KPI。"
  },
  "tables": [
    {
      "logical_name": "overview_daily",
      "display_name": "全站每日数据",
      "stable_key": "每日键",
      "grain": "站点 × 数据日期",
      "fields": [
        {"key": "daily_key", "name": "每日键", "type": "text", "required": true, "source": "system"},
        {"key": "site", "name": "站点", "type": "text", "required": true, "source": "system"},
        {"key": "data_date", "name": "数据日期", "type": "datetime", "required": true, "source": "system"},
        {"key": "data_status", "name": "数据状态", "type": "select", "required": true, "source": "system"},
        {"key": "ga4_sessions", "name": "官网访问次数", "type": "number", "required": true, "source": "ga4.sessions", "aggregation": "sum"},
        {"key": "ga4_key_events", "name": "表单提交事件（GA4）", "type": "number", "required": true, "source": "ga4.keyEvents", "aggregation": "sum"},
        {"key": "gsc_clicks", "name": "Google自然搜索点击", "type": "number", "required": true, "source": "gsc.clicks", "aggregation": "sum"},
        {"key": "gsc_impressions", "name": "Google搜索曝光", "type": "number", "required": true, "source": "gsc.impressions", "aggregation": "sum"},
        {"key": "stored_submissions", "name": "表单入库总数", "type": "number", "required": true, "source": "inquiry.storedSubmissions", "aggregation": "sum"},
        {"key": "accepted_inquiries", "name": "官网入库询盘", "type": "number", "required": true, "source": "inquiry.nonQuarantinedSubmissions", "aggregation": "sum"},
        {"key": "product_page_sessions", "name": "产品页访问次数", "type": "number", "required": true, "source": "page_dimension + ga4", "aggregation": "sum"},
        {"key": "information_page_sessions", "name": "信息页访问次数", "type": "number", "required": true, "source": "page_dimension + ga4", "aggregation": "sum"},
        {"key": "other_page_sessions", "name": "其他页面访问次数", "type": "number", "required": true, "source": "page_dimension + ga4", "aggregation": "sum"},
        {"key": "classified_page_sessions", "name": "已分类页面访问次数", "type": "number", "required": true, "source": "derived", "aggregation": "sum"},
        {"key": "page_classification_version", "name": "页面分类版本", "type": "text", "required": true, "source": "page_dimension"},
        {"key": "product_mapping_version", "name": "产品映射版本", "type": "text", "required": true, "source": "product_mapping"},
        {"key": "information_mapping_version", "name": "信息映射版本", "type": "text", "required": true, "source": "information_mapping"},
        {"key": "refreshed_at", "name": "数据更新时间", "type": "datetime", "required": true, "source": "system"},
        {"key": "source_boundary_note", "name": "来源口径说明", "type": "text", "required": true, "source": "system"}
      ]
    },
    {
      "logical_name": "product_daily",
      "display_name": "产品每日数据",
      "stable_key": "产品每日键",
      "grain": "站点 × 数据日期 × 产品末级分类",
      "fields": [
        {"key": "product_daily_key", "name": "产品每日键", "type": "text", "required": true, "source": "system"},
        {"key": "daily_key", "name": "每日键", "type": "text", "required": true, "source": "system"},
        {"key": "site", "name": "站点", "type": "text", "required": true, "source": "system"},
        {"key": "data_date", "name": "数据日期", "type": "datetime", "required": true, "source": "system"},
        {"key": "data_status", "name": "数据状态", "type": "select", "required": true, "source": "system"},
        {"key": "product_line_id", "name": "产品分类ID", "type": "text", "required": true, "source": "product_mapping"},
        {"key": "product_name", "name": "产品分类", "type": "text", "required": true, "source": "product_mapping"},
        {"key": "category_l1", "name": "一级分类", "type": "select", "required": true, "source": "product_mapping"},
        {"key": "category_l2", "name": "二级分类", "type": "select", "required": false, "source": "product_mapping"},
        {"key": "category_l3", "name": "三级分类", "type": "select", "required": false, "source": "product_mapping"},
        {"key": "ga4_sessions", "name": "官网访问次数", "type": "number", "required": true, "source": "ga4.sessions", "aggregation": "sum"},
        {"key": "gsc_clicks", "name": "Google自然搜索点击", "type": "number", "required": true, "source": "gsc.clicks", "aggregation": "sum"},
        {"key": "gsc_impressions", "name": "Google搜索曝光", "type": "number", "required": true, "source": "gsc.impressions", "aggregation": "sum"},
        {"key": "stored_submissions", "name": "表单入库总数", "type": "number", "required": true, "source": "inquiry.storedSubmissions", "aggregation": "sum"},
        {"key": "accepted_inquiries", "name": "官网入库询盘", "type": "number", "required": true, "source": "inquiry.nonQuarantinedSubmissions", "aggregation": "sum"},
        {"key": "included_pages", "name": "当日纳入页面数", "type": "number", "required": true, "source": "page_dimension", "aggregation": "non_additive"},
        {"key": "mapping_version", "name": "产品映射版本", "type": "text", "required": true, "source": "product_mapping"},
        {"key": "refreshed_at", "name": "数据更新时间", "type": "datetime", "required": true, "source": "system"}
      ]
    },
    {
      "logical_name": "information_daily",
      "display_name": "信息页每日数据",
      "stable_key": "信息每日键",
      "grain": "站点 × 数据日期 × 信息主题 × 内容类型",
      "fields": [
        {"key": "information_daily_key", "name": "信息每日键", "type": "text", "required": true, "source": "system"},
        {"key": "daily_key", "name": "每日键", "type": "text", "required": true, "source": "system"},
        {"key": "site", "name": "站点", "type": "text", "required": true, "source": "system"},
        {"key": "data_date", "name": "数据日期", "type": "datetime", "required": true, "source": "system"},
        {"key": "data_status", "name": "数据状态", "type": "select", "required": true, "source": "system"},
        {"key": "theme_id", "name": "信息主题ID", "type": "text", "required": true, "source": "information_mapping"},
        {"key": "theme", "name": "信息主题", "type": "select", "required": true, "source": "information_mapping"},
        {"key": "content_type_id", "name": "内容类型ID", "type": "text", "required": true, "source": "information_mapping"},
        {"key": "content_type", "name": "内容类型", "type": "select", "required": true, "source": "information_mapping"},
        {"key": "ga4_sessions", "name": "官网访问次数", "type": "number", "required": true, "source": "ga4.sessions", "aggregation": "sum"},
        {"key": "gsc_clicks", "name": "Google自然搜索点击", "type": "number", "required": true, "source": "gsc.clicks", "aggregation": "sum"},
        {"key": "gsc_impressions", "name": "Google搜索曝光", "type": "number", "required": true, "source": "gsc.impressions", "aggregation": "sum"},
        {"key": "stored_submissions", "name": "表单入库总数", "type": "number", "required": true, "source": "inquiry.storedSubmissions", "aggregation": "sum"},
        {"key": "accepted_inquiries", "name": "官网入库询盘", "type": "number", "required": true, "source": "inquiry.nonQuarantinedSubmissions", "aggregation": "sum"},
        {"key": "included_pages", "name": "当日纳入页面数", "type": "number", "required": true, "source": "page_dimension", "aggregation": "non_additive"},
        {"key": "mapping_version", "name": "信息映射版本", "type": "text", "required": true, "source": "information_mapping"},
        {"key": "refreshed_at", "name": "数据更新时间", "type": "datetime", "required": true, "source": "system"}
      ]
    }
  ]
}
