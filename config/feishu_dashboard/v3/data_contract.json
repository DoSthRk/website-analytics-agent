        {"key": "included_pages", "name": "纳入统计页面数", "type": "number", "required": true, "source": "page_dimension"},
        {"key": "sessions_delta", "name": "访问较上期", "type": "number", "required": false, "source": "derived"},
        {"key": "clicks_delta", "name": "搜索点击较上期", "type": "number", "required": false, "source": "derived"},
        {"key": "inquiries_delta", "name": "入库询盘较上期", "type": "number", "required": false, "source": "derived"},
        {"key": "mapping_version", "name": "产品映射版本", "type": "text", "required": true, "source": "product_mapping"},
        {"key": "mapping_status", "name": "统计状态", "type": "select", "required": true, "source": "product_mapping"},
        {"key": "operations_hint", "name": "运营提示", "type": "text", "required": false, "source": "derived"},
        {"key": "refreshed_at", "name": "数据更新时间", "type": "datetime", "required": true, "source": "system"}
      ]
    },
