{
  "version": "3",
  "status": "draft",
  "write_enabled": false,
  "site": "genemedi-net",
  "model": "time_x_product_with_information_dimensions",
  "source_boundaries": {
    "ga4": "访问、访客、互动和关键事件；按 GA4 属性报表时区统计。",
    "gsc": "Google 自然搜索点击、曝光、点击率和平均排名；按 Pacific Time 统计。",
    "inquiry": "官网数据库入库记录；按网站服务器日历统计。",
    "rule": "三个来源并列观察，不拼成严格转化漏斗。"
  },
  "tables": [
    {
      "logical_name": "overview_periods",
      "display_name": "全站周期数据",
      "stable_key": "周期键",
      "grain": "站点 × 周期",
      "fields": [
        {"key": "period_key", "name": "周期键", "type": "text", "required": true, "source": "system"},
        {"key": "site", "name": "站点", "type": "text", "required": true, "source": "system"},
        {"key": "period_label", "name": "周期", "type": "text", "required": true, "source": "system"},
        {"key": "period_kind", "name": "统计粒度", "type": "select", "required": true, "source": "system"},
        {"key": "period_start", "name": "周期开始", "type": "datetime", "required": true, "source": "system"},
        {"key": "period_end", "name": "周期结束", "type": "datetime", "required": true, "source": "system"},
        {"key": "is_current", "name": "当前周期", "type": "checkbox", "required": true, "source": "system"},
        {"key": "dashboard_windows", "name": "看板窗口", "type": "multi_select", "required": true, "source": "system"},
        {"key": "data_status", "name": "数据状态", "type": "select", "required": true, "source": "system"},
        {"key": "ga4_sessions", "name": "官网访问次数", "type": "number", "required": true, "source": "ga4.sessions"},
        {"key": "ga4_active_users", "name": "官网访客数", "type": "number", "required": true, "source": "ga4.activeUsers"},
        {"key": "ga4_key_events", "name": "表单提交事件（GA4）", "type": "number", "required": true, "source": "ga4.keyEvents"},
        {"key": "gsc_clicks", "name": "Google自然搜索点击", "type": "number", "required": true, "source": "gsc.clicks"},
        {"key": "gsc_impressions", "name": "Google搜索曝光", "type": "number", "required": true, "source": "gsc.impressions"},
        {"key": "gsc_ctr", "name": "搜索点击率", "type": "percentage", "required": false, "source": "gsc.clicks / gsc.impressions"},
        {"key": "gsc_position", "name": "平均搜索排名", "type": "number", "required": false, "source": "gsc.position"},
        {"key": "stored_submissions", "name": "表单入库总数", "type": "number", "required": true, "source": "inquiry.storedSubmissions"},
        {"key": "accepted_inquiries", "name": "官网入库询盘", "type": "number", "required": true, "source": "inquiry.nonQuarantinedSubmissions"},
        {"key": "product_page_sessions", "name": "产品页访问次数", "type": "number", "required": true, "source": "page_dimension + ga4"},
        {"key": "information_page_sessions", "name": "信息页访问次数", "type": "number", "required": true, "source": "page_dimension + ga4"},
        {"key": "other_page_sessions", "name": "其他页面访问次数", "type": "number", "required": true, "source": "page_dimension + ga4"},
        {"key": "page_classification_rate", "name": "页面访问分类覆盖率", "type": "percentage", "required": false, "source": "page_dimension"},
        {"key": "sessions_delta", "name": "访问较上期", "type": "number", "required": false, "source": "derived"},
        {"key": "clicks_delta", "name": "搜索点击较上期", "type": "number", "required": false, "source": "derived"},
        {"key": "inquiries_delta", "name": "入库询盘较上期", "type": "number", "required": false, "source": "derived"},
        {"key": "ga4_available_through", "name": "GA4数据截至", "type": "datetime", "required": true, "source": "system"},
        {"key": "gsc_available_through", "name": "GSC数据截至", "type": "datetime", "required": true, "source": "system"},
        {"key": "inquiry_available_through", "name": "询盘数据截至", "type": "datetime", "required": true, "source": "system"},
        {"key": "refreshed_at", "name": "数据更新时间", "type": "datetime", "required": true, "source": "system"},
        {"key": "operations_summary", "name": "运营摘要", "type": "text", "required": false, "source": "derived"}
      ]
    },
    {
